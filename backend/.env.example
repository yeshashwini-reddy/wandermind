# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Unsplash API Access Key (Public Photo Search)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Coverr API Key (Free Travel Videos Search)
COVERR_API_KEY=your_coverr_api_key_here

# OpenWeather API Key (Optional - mock fallback automatically kicks in if not provided)
OPENWEATHER_API_KEY=your_openweather_key_here

# Server Port and Host
PORT=8000
HOST=127.0.0.1
DEBUG=True
